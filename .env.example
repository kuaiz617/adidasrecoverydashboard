# Local mode is the default and uses the CSV files committed in data/.
DATA_BACKEND=local

# Tinybird mode: set these values on Render, not in the repository.
# DATA_BACKEND=tinybird
# TINYBIRD_API_BASE=https://api.us-east.tinybird.co
# TINYBIRD_TOKEN=replace_with_tinybird_read_token
# REQUIRE_TINYBIRD=false

# Optional pipe name overrides. Leave these alone if you use the names in tinybird/pipes/.
# TINYBIRD_PIPE_QUARTERLY=adidas_quarterly_metrics_api
# TINYBIRD_PIPE_DIVISIONAL=adidas_divisional_revenue_api
# TINYBIRD_PIPE_SENTIMENT=adidas_news_sentiment_api
# TINYBIRD_PIPE_STOCK=ads_stock_prices_api
# TINYBIRD_PIPE_SOCIAL=adidas_social_snapshot_api
# TINYBIRD_PIPE_INSTAGRAM=adidas_instagram_followers_api
